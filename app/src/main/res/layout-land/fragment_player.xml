<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/bg_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:translationZ="-2dp">

        <dev.brahmkshatriya.echo.utils.image.KenBurnsImageView
            android:id="@+id/bg_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toTopOf="@+id/bg_gradient"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:visibility="gone"
            app:show_buffering="always"
            app:use_controller="false" />

        <include
            android:id="@+id/bgPanel"
            layout="@layout/item_click_panels" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/fg_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/bg_gradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:translationZ="-2dp"
            app:layout_constraintBottom_toTopOf="@+id/view_pager"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintTop_toBottomOf="@+id/bg_image"
            app:srcCompat="@drawable/gradient_track"
            app:tint="?echoBackground" />

        <View
            android:id="@+id/bg_collapsed"
            android:layout_width="match_parent"
            android:layout_height="@dimen/collapsed_cover_size"
            android:layout_marginVertical="8dp"
            android:background="@drawable/shape_miniplayer_bg"
            android:backgroundTint="?colorSurfaceContainerHigh"
            android:translationZ="-1dp" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraint_layout"
                style="@style/PlayerExpandedConstraintLayout">

                <View
                    android:id="@+id/player_track_cover_placeholder"
                    style="@style/PlayerTrackCoverContainer"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/expanded_toolbar"
                    android:layout_marginEnd="6dp"
                    app:contentInsetEnd="0dp"
                    style="@style/PlayerToolbarStyle" >
                    <!-- [2026-11-07] THE OVERFLOW IS BACK IN THE TOP BAR, as its rightmost item: down arrow, "Playing from",
                         extension icon, more. A CHILD VIEW, NOT A MENU ITEM, ON PURPOSE: PlayerToolbarStyle is shared with the TV player
                         (fragment_player_tv.xml's tvToolbar), and bc25f358 (2026-08-28) broke the TV overflow by editing that style.
                         The TV now inflates its own menu (PlayerTvFragment.configureBack), so a `menu` in the style would give it two.
                         Nothing here touches the style.
                         ORDER: Toolbar lays out END-gravity children from the right edge inward in XML order (appcompat 1.8.0
                         Toolbar.java:2140-2145, addCustomViewsWithGravity at :2266), so playerMore, first, is rightmost.
                         SIZES: both are 48dp touch targets with 10dp padding, so both glyphs are 28dp (the more glyph's iconSize beside
                         the heart, the Aug 29 spacing fix), on one line, with a borderless ripple. contentInsetEnd 0 and marginEnd 6dp
                         on the toolbar (overriding the style here only) put the more glyph 6 + 10 = 16dp from the edge (plus any
                         system-bar padding applyInsets adds), the 16dp grid of the cover and the controls row.
                         THE TITLE: MaterialToolbar (1.14.0) narrows a centred title or subtitle symmetrically until it clears every
                         visible child (calculateTitleBoundLimits / layoutTitleCenteredHorizontally), and Toolbar makes both single-line
                         with an end ellipsis (Toolbar.java:834-835, 889-890), so a long name ellipsizes rather than reaching the icons.
                         The rest of the bar keeps the "Playing from" tap: both buttons consume only their own 48dp. -->
                    <ImageButton
                        android:id="@+id/playerMore"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/more"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_more_vert"
                        app:tint="@color/button_player" />
                    <!-- Playing extension's icon, in the top right where the overflow menu used to sit (the
                         overflow moved down beside the heart). Driven from applyCurrent, i.e. from the PLAYING
                         extension on the current MediaItem - deliberately NOT from extensionLoader.current, which
                         is the BROWSING extension and would change the icon while a track from another extension
                         kept playing. A queue mixing extensions therefore updates this per track.
                         Starts on ic_extension_32dp rather than empty so an extension with no icon, and the
                         window before the first track resolves, both show the generic glyph instead of a hole.

                         PURELY INFORMATIONAL - DO NOT GIVE THIS A CLICK LISTENER. applyCurrent sets an
                         OnClickListener on the WHOLE toolbar ("Playing from <context>" -> opens that playlist or
                         artist), so the entire top bar is one uniform tap target. An ImageView is not clickable by
                         default, returns false from onTouchEvent, and the Toolbar consumes the event instead - so
                         taps here fall through to that action, which is the intent, not an oversight.
                         Adding a listener would carve a 32dp dead island out of the middle of a target users aim
                         at loosely, and would make the same gesture do two different things a few dp apart. The
                         extension is not something you switch mid-playback, and the selector is reachable
                         elsewhere. importantForAccessibility=no for the same reason: TalkBack should describe the
                         toolbar's action, not announce a second element inside it. No contentDescription for the
                         same reason - one would imply it is actionable.
                         [CORRECTED 2026-11-07] Decision changed by the user: the icon is now tappable and opens the settings page
                         (ExtensionInfoFragment) of the extension the song plays from - the Unified stamp, else the item's own
                         extension, and the icon is loaded from that same id (PlayerViewModel.getPlayingExtension). The near-miss
                         trade-off above (a tap just beside it opens the playlist) is accepted. It now has a content description,
                         "<name> settings", set in PlayerFragment.applyCurrent, and a 48dp target with a borderless ripple. It sits
                         just left of the overflow, which is back in the top bar (playerMore above). -->
                    <ImageButton
                        android:id="@+id/extensionIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_extension_32dp" />
                    </com.google.android.material.appbar.MaterialToolbar>

                <include
                    android:id="@+id/player_controls"
                    layout="@layout/item_player_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/player_more_container"
                    android:name="dev.brahmkshatriya.echo.ui.player.more.PlayerMoreFragment"
                    style="@style/Widget.Material3.BottomSheet"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:outlineProvider="none"
                    app:backgroundTint="@android:color/transparent"
                    app:behavior_hideable="false"
                    app:behavior_peekHeight="@dimen/player_info_peek_height"
                    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
                    tools:layout="@layout/fragment_player_more" />

            </androidx.coordinatorlayout.widget.CoordinatorLayout>

        </LinearLayout>

        <include
            android:id="@+id/player_collapsed_container"
            layout="@layout/item_player_collapsed_controls" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>