<?xml version="1.0" encoding="utf-8"?>
<!-- THE TV FOCUS RING, PILL SHAPE (2026-11-01): the one definition of the 4dp ?attr/colorPrimary ring. tv_focus_pill shows
     it on state_focused; TvFocusRing draws it directly as an overlay. The 100dp radius clamps to half the height, so it
     renders fully rounded. No fill (a fill would tint the button). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <stroke android:width="4dp" android:color="?attr/colorPrimary" />
    <corners android:radius="100dp" />
</shape>
