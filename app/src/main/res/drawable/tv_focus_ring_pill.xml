<?xml version="1.0" encoding="utf-8"?>
<!-- THE TV FOCUS RING, PILL SHAPE (2026-11-01): the one definition of the 4dp ?attr/colorPrimary ring. tv_focus_pill shows
     it on state_focused; TvFocusRing draws it directly as an overlay. The 100dp radius clamps to half the height, so it
     renders fully rounded. No fill (a fill would tint the button).
     [CORRECTED 2026-11-04] Two-tone, no longer one colour: the same pink ring plus a 2dp ?attr/colorSurface gap inside
     it, 6dp in all, inside the view's bounds. A pink ring alone vanished on a pink Play pill, and white would not work
     either: white against the dark theme's #FFB2BB is 1.7:1. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="?attr/colorPrimary" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="?attr/colorSurface" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</layer-list>
