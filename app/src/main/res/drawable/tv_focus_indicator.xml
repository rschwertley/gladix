<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <!-- Matching strong 4dp oval ring (was 2dp). No interior fill: a fill inside a round icon button
             would dim the icon; the thick ring is the cue.
             [CORRECTED 2026-11-04] Two-tone, like tv_focus_ring_pill: a 2dp ?attr/colorSurface gap inside the ring. -->
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="4dp" android:color="?attr/colorPrimary" />
                </shape>
            </item>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="?attr/colorSurface" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
