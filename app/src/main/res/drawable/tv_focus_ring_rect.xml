<?xml version="1.0" encoding="utf-8"?>
<!-- THE TV FOCUS RING, CARD/ROW SHAPE (2026-11-01): the Jul 20 card border's stroke - 4dp ?attr/colorPrimary at
     ?itemCorner - as its own drawable, so tv_focused_list_item and TvFocusRing draw the same ring.
     [CORRECTED 2026-11-04] Two-tone, like tv_focus_ring_pill: 6dp in all, so a row's clearance must now be above 6dp.
     The inner 8dp is TV's 12dp item_corner (values-land-television) minus the ring, so the two curves stay parallel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="?attr/colorPrimary" />
            <corners android:radius="?itemCorner" />
        </shape>
    </item>
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="?attr/colorSurface" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
