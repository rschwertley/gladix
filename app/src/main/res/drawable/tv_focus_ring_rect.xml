<?xml version="1.0" encoding="utf-8"?>
<!-- THE TV FOCUS RING, CARD/ROW SHAPE (2026-11-01): the Jul 20 card border's stroke - 4dp ?attr/colorPrimary at
     ?itemCorner - as its own drawable, so tv_focused_list_item and TvFocusRing draw the same ring. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <stroke android:width="4dp" android:color="?attr/colorPrimary" />
    <corners android:radius="?itemCorner" />
</shape>
