    <!-- ⚠️ WIDGET COLOURS BELOW ANDROID 12 (2026-10-30). The widget layouts used @color/material_dynamic_* directly,
         which below API 31 is Material's purple baseline palette (a RemoteViews widget never sees the app's theme).
         These are the same tones of the SchemeContent primary / tertiary palettes from #E8185A (see above);
         values-v31/colors.xml aliases every one back to the @color/material_dynamic_* it replaced, so Android 12+
         is unchanged. Not night-qualified: the material_dynamic_* tones they stand in for are not either. -->
    <color name="echo_widget_primary40">#BD0045</color>
    <color name="echo_widget_primary50">#E7175A</color>
    <color name="echo_widget_primary60">#FF4F76</color>
    <color name="echo_widget_primary90">#FFD9DD</color>
    <color name="echo_widget_tertiary50">#CC4F00</color>
    <color name="echo_widget_tertiary90">#FFDBCD</color>
