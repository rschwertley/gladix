    <!-- ⚠️ GLADIX PINK BELOW ANDROID 12 (2026-10-30). The Material 3 colour roles for Platform.Theme.Echo
         (values/themes.xml), used ONLY below API 31: values-v31 defines that style empty, so Android 12+
         resolves exactly the theme it did before and never reads these. Generated with Google's
         material-color-utilities 0.3.0 (npm), SchemeContent from #E8185A (@color/app_color), contrast 0 -
         the same scheme DynamicColors builds from the default seed on 12+ (DynamicColors.applyToActivityIfAvailable
         -> new SchemeContent(...)). Regenerate rather than hand-edit if app_color changes. Light here, dark in
         values-night. echo_m3_opposite_* are the OTHER mode's values, for the *Inverse text colours. -->
    <color name="echo_m3_primary">#B80043</color>
    <color name="echo_m3_on_primary">#FFFFFF</color>
    <color name="echo_m3_primary_container">#E41257</color>
    <color name="echo_m3_on_primary_container">#FFFBFF</color>
    <color name="echo_m3_inverse_primary">#FFB2BB</color>
    <color name="echo_m3_primary_fixed">#FFD9DD</color>
    <color name="echo_m3_primary_fixed_dim">#FFB2BB</color>
    <color name="echo_m3_on_primary_fixed">#400012</color>
