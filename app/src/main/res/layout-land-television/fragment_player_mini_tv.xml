<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tvMiniPlayer"
    tools:ignore="MissingDefaultResource"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurfaceContainer"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/tv_focused_list_item"
    android:nextFocusDown="@id/tvMiniPlayer"
    android:nextFocusLeft="@id/tvMiniPlayer"
    android:nextFocusRight="@+id/miniPlayPause"
    android:nextFocusUp="@id/navHostFragment"
    android:visibility="gone">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- art | title + artist | play/pause -->
    <!-- Text sizes (2026-10-31): the July TV sizing pass brought feed rows to 22sp titles / 18sp subtitles
         (TV item_shelf_media, item_history) but skipped this bar, which stayed at Material's 14sp TitleSmall /
         BodyMedium - unreadable from the couch. Now the same 22sp / 18sp. Title uses TitleLarge (22sp, 28sp line
         height); the artist keeps BodyLarge's 24sp line height at 18sp. 28 + 2 + 24 = 54dp of text in the 72dp
         row at the default font scale, so the row height and UiViewModel's 85dp tvMiniReservePx are unchanged. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/miniArt"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music"
            app:shapeAppearanceOverlay="@style/TvMiniCoverShape" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/miniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/miniArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.7"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textSize="18sp" />

        </LinearLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/miniPlayPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ripple_60dp"
            android:foreground="@drawable/tv_focus_indicator"
            android:button="@drawable/anim_play_pause_48dp"
            android:checked="true"
            android:contentDescription="@string/play"
            android:focusable="true"
            android:nextFocusDown="@id/miniPlayPause"
            android:nextFocusLeft="@id/tvMiniPlayer"
            android:nextFocusRight="@id/miniPlayPause"
            android:nextFocusUp="@id/navHostFragment"
            app:buttonTint="@color/button_player" />

    </LinearLayout>

    <!-- Thin progress bar pinned to the bottom of the bar -->
    <ProgressBar
        android:id="@+id/miniProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:max="1000"
        android:progress="0"
        android:progressBackgroundTint="?attr/colorSurfaceContainerHighest"
        android:progressTint="?attr/colorPrimary" />

</LinearLayout>
