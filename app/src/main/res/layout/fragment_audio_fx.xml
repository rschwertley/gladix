<?xml version="1.0" encoding="utf-8"?>
<me.zhanghai.android.fastscroll.FastScrollNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="24dp"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- ONE AUDIO EFFECTS SCREEN (2026-11-01): this layout is the whole content of BOTH the player's sheet and
             Settings -> Audio effects, wired by AudioEffectsBottomSheet.setupAudioFx. The description and the reset
             row live here, not in either container, so the two cannot drift apart. -->
        <TextView
            android:id="@+id/audioFxDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="16dp"
            android:alpha="0.66"
            android:text="@string/audio_fx_summary"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:text="@string/playback_speed"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp" />

        <!-- Playback speed is a stepped Slider over INDICES into EffectsListener.speedRange (2026-10-31), replacing
             the ruler; valueTo is speedRange.lastIndex and is set from code. Value text styled as trueCrossfadeValue. -->
        <TextView
            android:id="@+id/speedValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:textColor="?colorPrimary"
            android:textSize="16sp"
            tools:text="1x" />

        <com.google.android.material.slider.Slider
            android:id="@+id/speedSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="8dp"
            android:stepSize="1"
            android:value="0"
            android:valueFrom="0"
            android:valueTo="1" />

        <LinearLayout
            android:id="@+id/pitch"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?selectableItemBackground"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingVertical="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:minHeight="44sp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/change_pitch_with_speed"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.66"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="@string/change_pitch_with_speed_desc" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/pitchSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="24dp"
                android:clickable="false" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:text="@string/bass_boost"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:alpha="0.66"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text="@string/bass_boost_desc" />

        <com.google.android.material.slider.Slider
            android:id="@+id/bassBoostSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="8dp"
            android:stepSize="1"
            android:value="0"
            android:valueFrom="0"
            android:valueTo="10" />

        <LinearLayout
            android:id="@+id/equalizer"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?selectableItemBackground"
            android:baselineAligned="false"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equalizer"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.66"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="@string/equalizer_summary" />
        </LinearLayout>

        <!--
            TRUE CROSSFADE. Same key as Settings -> Player (TRUE_CROSSFADE_SECONDS), same 0..10 range,
            same 0 default; the two screens are two views of one preference, not two settings.

            The Track Fade row, its value label and its 1-5 s slider stood directly above this block
            until Build 2 (2026-10-15) and are deleted, not migrated. @id/skipFadeOnAlbums below now
            belongs to THIS slider: it is shown when the overlap is on (> 0) and hidden when it is off,
            which is what the deleted crossfade switch used to decide.

            No switch row, because 0 IS off - so there is no click target, hence no
            ?selectableItemBackground, and one less level of nesting than a switch row needs. The value
            label and slider below keep the attributes they were copied from.

            The summary carries a format argument (the 0-10 range), which android:text cannot supply,
            so FragmentAudioFxBinding.bind sets it from the same string resource the settings screen
            uses. tools:text here is preview only.
        -->
        <LinearLayout
            android:id="@+id/trueCrossfade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:gravity="center_vertical"
            android:minHeight="44sp"
            android:orientation="vertical"
            android:paddingVertical="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/true_crossfade"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/trueCrossfadeSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.66"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Overlap in seconds (0–10), 0 = off" />

        </LinearLayout>

        <TextView
            android:id="@+id/trueCrossfadeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:textColor="?colorPrimary"
            android:textSize="16sp"
            tools:text="0s" />

        <com.google.android.material.slider.Slider
            android:id="@+id/trueCrossfadeSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="8dp"
            android:stepSize="1"
            android:value="0"
            android:valueFrom="0"
            android:valueTo="12" />

        <LinearLayout
            android:id="@+id/skipFadeOnAlbums"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?selectableItemBackground"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingVertical="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:minHeight="44sp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/skip_fade_on_albums"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.66"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="@string/skip_fade_on_albums_summary" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/skipFadeOnAlbumsSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="24dp"
                android:clickable="false" />

        </LinearLayout>

        <!-- Labelled reset, last row, both screens (2026-11-01) - replaces the unlabelled refresh icon each toolbar
             had. Asks first; see setupAudioFx. -->
        <LinearLayout
            android:id="@+id/resetAudioFx"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?selectableItemBackground"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset_audio_fx"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />
        </LinearLayout>

    </LinearLayout>


</me.zhanghai.android.fastscroll.FastScrollNestedScrollView>