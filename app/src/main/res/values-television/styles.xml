<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thicker outline and larger min height for 10-foot UI readability -->
    <style name="OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textSize">18sp</item>
        <item name="iconPadding">24dp</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- TV override of values/styles.xml's EchoBottomSheetStyle (2026-10-31): same items, bigger peek. The 512dp
         peek left the bottom of any taller sheet off a ~540dp-high TV screen, and a D-pad cannot drag a sheet
         up. With fitToContents (the default) BottomSheetBehavior.calculateCollapsedOffset (Material 1.14.0) uses
         max(parentHeight - peek, fitToContentsOffset), so a peek taller than the screen opens every sheet fully
         shown, top at most at the screen top. Keep the other two items in step with the phone style. -->
    <!-- TV FOCUS RING ON PLAIN DIALOG BUTTONS (2026-11-01). TvFocusRing reaches the main window and every DialogFragment,
         but an AlertDialog shown straight from a builder has no hook, so its buttons take the same pill ring as a
         foreground through these styles. TV overrides of values/styles.xml's EchoDialog and EchoAlertDialog: keep their
         items in step. Parents and attribute names read from material-1.14.0's values.xml
         (ThemeOverlay.Material3.MaterialAlertDialog sets these four; .Dialog / .Dialog.Flush are its values). -->
    <style name="TvDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:foreground">@drawable/tv_focus_pill</item>
    </style>

    <style name="TvDialogButton.Flush" parent="Widget.Material3.Button.TextButton.Dialog.Flush">
        <item name="android:foreground">@drawable/tv_focus_pill</item>
    </style>

    <style name="EchoDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="buttonBarButtonStyle">@style/TvDialogButton.Flush</item>
        <item name="buttonBarPositiveButtonStyle">@style/TvDialogButton.Flush</item>
        <item name="buttonBarNegativeButtonStyle">@style/TvDialogButton.Flush</item>
        <item name="buttonBarNeutralButtonStyle">@style/TvDialogButton.Flush</item>
        <!-- List rows (setItems / choice lists): see tv_focus_list_selector. -->
        <item name="listChoiceBackgroundIndicator">@drawable/tv_focus_list_selector</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/tv_focus_list_selector</item>
    </style>

    <style name="EchoAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/EchoDialogStyle</item>
        <item name="buttonBarButtonStyle">@style/TvDialogButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/TvDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/TvDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/TvDialogButton.Flush</item>
        <item name="listChoiceBackgroundIndicator">@drawable/tv_focus_list_selector</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/tv_focus_list_selector</item>
    </style>

    <style name="EchoBottomSheetStyle" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">?navBackground</item>
        <item name="behavior_peekHeight">4000dp</item>
        <item name="behavior_skipCollapsed">true</item>
    </style>
</resources>
